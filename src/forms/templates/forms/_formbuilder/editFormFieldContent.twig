{% import "_includes/forms" as forms %}
{% import "sprout-module-core/_macros/sproutcp" as sproutCp %}

<div id="form-field-general">
    {# Don't wrap namespace around div.id or tab switching won't work       #}
    {% namespace 'layoutElement' %}

        {% if field.allowRequired() %}
            {{ forms.lightswitchField({
                label: "Required"|t('sprout-module-forms'),
                name: 'required',
                on: fieldLayoutElement.required ?? false,
                first: true
            }) }}
        {% else %}
            {{ hiddenInput('required', '') }}
        {% endif %}

    {% endnamespace %}

    {% namespace 'layoutElement[formField]' %}
        {{ forms.textField({
            label: 'Name'|t('sprout-module-forms') ~ sproutCp.infoIcon(
                'The field label displayed to your users.'|t('sprout-module-forms')
            ),
            id: 'field-name',
            name: 'name',
            value: (field is defined ? field.name : null),
            errors: (field is defined ? field.getErrors('name') : null),
            required: true,
            autofocus: true,
            first: not field.allowRequired()
        }) }}

        {% if field.displayInstructionsField %}
            {{ forms.textareaField({
                label: 'Instructions'|t('sprout-module-forms') ~ sproutCp.infoIcon(
                    'Instructions to guide your users when filling out this field.'|t('sprout-module-forms')
                ),
                id: 'instructions',
                class: 'nicetext',
                name: 'instructions',
                value: (field is defined ? field.instructions : null),
                errors: (field is defined ? field.getErrors('instructions') : null)
            }) }}
        {% endif %}

    {% endnamespace %}

    {% namespace 'layoutElement[formField][settings]' %}
        {{ field.getSettingsHtml()|raw }}
    {% endnamespace %}
</div>

<div id="form-field-advanced" class="hidden">
    {% namespace 'layoutElement[formField]' %}
        {{ forms.textField({
            label: 'Handle'|t('sprout-module-forms'),
            name: 'handle',
            value: field.handle,
            errors: field.getErrors('handle'),
            required: true,
            first: true,
        }) }}

        {{ forms.lightswitchField({
            label: "Hidden"|t('sprout-module-forms'),
            instructions: "Don't display the field to users on the front-end. Field will still be visible in the code."|t('sprout-module-forms'),
            name: 'hidden',
            on: field.isHidden ?? false,
        }) }}

        {{ forms.editableTableField({
            label: "CSS Classes"|t('sprout-module-forms'),
            instructions: "Custom CSS classes that will be added to the container."|t('sprout-module-forms'),
            name: 'cssClasses',
            cols: {
                label: {
                    type: 'singleline',
                    heading: "Attribute"|t('sprout-module-forms'),
                    info: 'i.e. color, font-size, etc.',
                    class: 'code',
                },
                metadatumFormat: {
                    type: 'singleline',
                    heading: "Value"|t('sprout-module-forms'),
                    info: 'i.e. red, 12px, etc.',
                    class: 'code',
                },
            }|filter,
            rows: field.cssClasses,
            fullWidth: true,
            allowAdd: true,
            allowReorder: true,
            allowDelete: true,
            minRows: 0,
            errors: field.getErrors('cssClasses'),
        }) }}

        <hr>

        {{ forms.textField({
            label: 'Field Type'|t('sprout-module-forms'),
            name: 'type',
            value: field.displayName(),
            readonly: true,
            disabled: true,
        }) }}

        {{ forms.textField({
            label: 'Field Class'|t('sprout-module-forms'),
            name: 'class',
            value: className(field),
            readonly: true,
            disabled: true,
        }) }}
    {% endnamespace %}
</div>

